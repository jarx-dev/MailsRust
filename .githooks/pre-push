#!/usr/bin/env bash
# pre-push: clippy for the Windows target must pass and add no warnings (AGENTS.md, "Lint").
# Tests run only on Windows, so CI runs them. Turn on once per clone (relative, so every
# worktree runs its own copy): git config core.hooksPath ./.githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Only top-level *.md, docs/ or LICENSE in every pushed ref: nothing to lint, as CI skips its
# build then (.github/workflows/ci.yml). What cannot be told (nothing new, a ref not fetched)
# runs the checks.
docs_only() {
  local any=0 lref lsha rref rsha files
  while read -r lref lsha rref rsha; do
    [[ $lsha =~ ^0+$ ]] && continue # a deleted branch
    # a new branch counts from where it left origin/main
    if [[ $rsha =~ ^0+$ ]]; then rsha=$(git merge-base "$lsha" origin/main) || return 1; fi
    files=$(git diff --no-renames --name-only "$rsha" "$lsha") || return 1
    [[ -n $files ]] || return 1
    ! grep -qvE '^[^/]+\.md$|^docs/|^LICENSE' <<<"$files" || return 1
    any=1
  done
  ((any))
}
if docs_only; then
  echo "[pre-push] same dokumenty: bez clippy"
  exit 0
fi

max=42 # known warnings of the bin; lower it when you fix some
export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-1.99.1} # egui 0.37 needs a newer rustc than older stables

echo "[pre-push] cargo xwin clippy"
log=$(mktemp)
trap 'rm -f "$log"' EXIT
if ! cargo xwin clippy --release --locked --target x86_64-pc-windows-msvc --all-targets >"$log" 2>&1; then
  tail -60 "$log"
  echo "[pre-push] clippy nie przeszedł"
  exit 1
fi
n=$(grep -oP '`mailclient` \(bin "mailclient"( test)?\) generated \K\d+' "$log" | sort -n | tail -1 || true)
if (( ${n:-0} > max )); then
  echo "[pre-push] ostrzeżeń clippy: $n, a dozwolone $max — usuń nowe ostrzeżenia"
  exit 1
fi
echo "[pre-push] OK (ostrzeżeń clippy: ${n:-0}/$max)"
